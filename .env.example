# Copy to .env and uncomment what you need. With nothing set, the app runs in
# static snapshot mode: the map and borough details come from
# src/lib/data/static-snapshot.json and the live agent pipeline is disabled.

# --- Database (Postgres + pgvector; matches docker-compose.yml) -------------
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/neighbourhood_os

# Force static snapshot mode even when DATABASE_URL is set.
# STATIC_SNAPSHOT=1

# --- Live agent pipeline ---------------------------------------------------
# Strategy, personalisation, graph extraction and Ideogram images.
# TOGETHER_AI_API_KEY=
# Event web search and memory embeddings.
# OPENAI_API_KEY=

# Model overrides (defaults shown).
# TOGETHER_ORCHESTRATOR_MODEL=moonshotai/Kimi-K2.6
# TOGETHER_AGENT_MODEL=moonshotai/Kimi-K2.6
# OPENAI_SEARCH_MODEL=gpt-4o-mini
# IDEOGRAM_MODEL=ideogram/ideogram-3.0

# --- Optional: paused Meta / TikTok campaigns via Pipeboard MCP ------------
# PIPEBOARD_API_TOKEN=
# META_AD_ACCOUNT_ID=
# TIKTOK_ADVERTISER_ID=

# --- Data pipeline options -------------------------------------------------
# Also write memory profiles during `pnpm seed`.
# SEED_MEMORY=1
# Skip LLM entity extraction in `pnpm seed:memory`.
# EXTRACT_GRAPH=0
# CBS_BASE_URL=https://opendata.cbs.nl/ODataFeed/odata
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
